rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // trip 소유자 확인
    function ownsTrip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    // trip 접근 가능 여부 (소유자 OR 공유 멤버)
    function canAccessTrip(tripId) {
      let t = get(/databases/$(database)/documents/trips/$(tripId));
      return t.data.userId == request.auth.uid ||
        (t.data.shareEnabled == true && request.auth.uid in t.data.sharedWith);
    }

    // ── 여행 ──────────────────────────────────────────────────
    match /trips/{tripId} {
      // 소유자 OR 공유 멤버 읽기 허용
      // shareEnabled인 경우 인증된 누구나 read 허용 (초대 링크로 접근 시 필요)
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.sharedWith ||
        resource.data.shareEnabled == true
      );

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;

      // 소유자: 모든 필드 수정 가능
      // 공유 멤버: sharedWith 배열(자기 자신 추가)만 수정 가능
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.sharedWith ||
        (
          resource.data.shareEnabled == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith'])
        )
      );

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }

    // ── 일정 ──────────────────────────────────────────────────
    match /schedules/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 여행 항목 (항공편·숙소·이동 등) ──────────────────────
    match /tripItems/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 여행 일기 ─────────────────────────────────────────────
    match /diary/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 저장된 장소 ───────────────────────────────────────────
    match /savedPlaces/{id} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── 사용자 프로필 ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;
    }
  }
}
