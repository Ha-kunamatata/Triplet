rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsTrip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    function canAccessTrip(tripId) {
      let t = get(/databases/$(database)/documents/trips/$(tripId));
      return t.data.userId == request.auth.uid
        || t.data.shareEnabled == true
        || (t.data.sharedWith is list && request.auth.uid in t.data.sharedWith);
    }

    // ── 여행 ──────────────────────────────────────────────────
    match /trips/{tripId} {

      // shareEnabled 이면 로그인한 누구나 읽기 가능 (초대 링크 조회 포함)
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId
        || resource.data.shareEnabled == true
        || (resource.data.sharedWith is list && request.auth.uid in resource.data.sharedWith)
      );

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;

      // 소유자: 모든 필드 수정 가능
      // shareEnabled 상태면 sharedWith 필드만 수정 가능 (자기 자신 추가/제거)
      // 기존 공유 멤버: sharedWith 필드만 수정 가능
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId
        || (resource.data.shareEnabled == true
            && request.resource.data.keys().hasAll(resource.data.keys())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith']))
        || (resource.data.sharedWith is list
            && request.auth.uid in resource.data.sharedWith
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith']))
      );

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }

    // ── 일정 ──────────────────────────────────────────────────
    match /schedules/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 여행 항목 ─────────────────────────────────────────────
    match /tripItems/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 여행 일기 ─────────────────────────────────────────────
    match /diary/{id} {
      allow get, list, update: if isSignedIn() && canAccessTrip(resource.data.tripId);
      allow delete:            if isSignedIn() && ownsTrip(resource.data.tripId);
      allow create:            if isSignedIn() && canAccessTrip(request.resource.data.tripId);
    }

    // ── 저장된 장소 ───────────────────────────────────────────
    match /savedPlaces/{id} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
    }

    // ── 사용자 프로필 ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;
    }
  }
}
